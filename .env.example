# ParaBank — local instance is the recommended target:
#   docker compose up -d parabank
# The public demo (https://parabank.parasoft.com) also works, but it wipes
# its database every few minutes, which makes runs flaky.
BASE_URL=http://localhost:8080

# Optional: pre-created test user. Leave unset and the suite will
# register a fresh customer automatically (recommended — the demo
# database is wiped periodically).
#TEST_USERNAME=
#TEST_PASSWORD=

# Browser
HEADLESS=true

# AI features (require a running Ollama: brew install ollama && ollama pull llama3.1:8b)
AI_ANALYSIS=false   # attach AI diagnosis to failed tests in the Allure report
SELF_HEAL=false     # let the AI repair broken locators at runtime
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
